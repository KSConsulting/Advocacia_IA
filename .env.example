# =============================================================================
#  .env — as duas chaves que a TELA precisa (copie para .env e preencha)
#
#  No deploy (Vercel), as MESMAS duas variáveis vão em
#  Settings → Environment Variables. O .env não sobe: está no .gitignore.
#
#  ⚠️ O Vite embute as variáveis no BUILD. Mudou aqui, gere o build de novo.
# =============================================================================

# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=

# Supabase → Project Settings → API → chave `anon` / `public`
#
# ⚠️ NUNCA a `service_role`. Este valor vai para o JavaScript entregue ao
#    navegador. A `anon` é pública por natureza e protegida pelo RLS; a
#    `service_role` ignora o RLS inteiro.
VITE_SUPABASE_ANON_KEY=
