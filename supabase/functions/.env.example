# =============================================================================
#  Secrets das Edge Functions (whatsapp e follow-up)
#
#  Em produção NÃO são lidas deste arquivo: sobem para o Supabase com
#      npx supabase secrets set --env-file supabase/functions/.env
#  (INSTALACAO.md, parte 3). Copie para supabase/functions/.env — que está
#  no .gitignore — e preencha.
#
#  SUPABASE_URL, SUPABASE_ANON_KEY e SUPABASE_SERVICE_ROLE_KEY o Supabase
#  entrega sozinho às funções. Não coloque aqui.
# =============================================================================

# --- IA ----------------------------------------------------------------------
# Obrigatória: conversa, transcrição de áudio (Whisper) e leitura de imagens.
OPENAI_API_KEY=
# Opcional: só se for usar um modelo Claude na secretária.
ANTHROPIC_API_KEY=

# --- Segredos que você inventa (texto longo e aleatório) ---------------------
# Vai na URL/cabeçalho do webhook da ponte de WhatsApp.
WEBHOOK_SEGREDO=
# O mesmo valor vai no Vault do banco (`follow_up_segredo`) — é como o pg_cron
# prova para a função follow-up que é ele chamando.
FOLLOW_UP_SEGREDO=

# --- Ponte de WhatsApp: preencha UMA e deixe a outra em branco --------------
# Evolution API v2
EVOLUTION_API_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCIA=

# uazapi v2 (token DA INSTÂNCIA, não o de admin)
UAZAPI_API_URL=
UAZAPI_TOKEN=
